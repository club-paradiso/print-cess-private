# Shared
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
PRINT_CESS_ADAPTER_MODE=local
# Public, unclaimed QR lifetime. Claiming the QR starts the separate session TTL below.
QR_TTL_SECONDS=120
SESSION_TTL_SECONDS=180
SIGNED_URL_TTL_SECONDS=120

# Visitor counter sessions (/visitor) for government and immigration counters.
# A visitor may queue before scanning, so the QR and its uploaded file live
# longer than the public QR window — but the same session-expiry cleanup still
# deletes the file when this elapses. Accepted range: 60..1800 seconds.
VISITOR_TTL_SECONDS=600

# File hand-off between two phones. A transfer is not a print job: the receiver
# may be in another room, so it lives minutes to hours rather than the two
# minutes a kiosk QR code is worth. Accepted range: 300..86400 seconds.
DROP_TTL_SECONDS=1800
# Ceiling for one transfer, in mebibytes. Accepted range: 16..32768.
DROP_MAX_TOTAL_MB=2048

ENABLE_BROWSER_KIOSK=true
ENABLE_DEMO_ROUTES=true

# Provider selection (external adapter mode only). When unset, external mode
# defaults to the original Upstash/Vercel/QStash stack for backward-compatible
# rollback. Select the Railway stack explicitly with the values below.
#   PRINT_CESS_SESSION_PROVIDER: upstash-redis (default) | railway-redis | railway-postgres
#   PRINT_CESS_BLOB_PROVIDER:    vercel-blob (default)    | railway-s3
#   PRINT_CESS_CLEANUP_PROVIDER: qstash (default)         | railway-worker
PRINT_CESS_SESSION_PROVIDER=
PRINT_CESS_BLOB_PROVIDER=
PRINT_CESS_CLEANUP_PROVIDER=

# Required in hosted Preview/Production. Production startup requires both secrets
# to contain at least 32 characters.
KIOSK_REGISTRATION_SECRET=
ADMIN_DIAGNOSTICS_SECRET=

# Vercel Private Blob. The current Production startup gate requires a
# BLOB_READ_WRITE_TOKEN containing at least 20 characters.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Upstash Redis. Production requires an HTTPS URL and a token containing at
# least 20 characters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_DISABLE_TELEMETRY=1

# Upstash QStash. Required only when PRINT_CESS_CLEANUP_PROVIDER=qstash (the
# default). Production requires all three values and each must contain at least
# 20 characters.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Railway provider stack (alternative to Upstash/Vercel/QStash) ---

# Railway Redis session store (PRINT_CESS_SESSION_PROVIDER=railway-redis).
# Must be a TLS connection; a non-rediss:// URL fails config validation and
# certificate verification is never disabled.
REDIS_URL=

# Existing Railway PostgreSQL session store
# (PRINT_CESS_SESSION_PROVIDER=railway-postgres). Use the public TLS connection
# URL when the Vercel Preview app connects across projects. The adapter creates
# only the isolated print_cess_preview_state_v1 table.
POSTGRES_URL=
# PEM root certificate read from the selected Railway Postgres service's
# /var/lib/postgresql/data/certs/root.crt. This pins the self-signed database CA.
POSTGRES_CA_CERT=
# DNS identity contained in the database certificate. Railway's generated
# certificate currently uses localhost, which is the secure default. Override
# only when the approved certificate contains a different exact DNS name.
POSTGRES_TLS_SERVER_NAME=localhost

# Railway private S3-compatible bucket (PRINT_CESS_BLOB_PROVIDER=railway-s3).
# The bucket must be private. Set S3_FORCE_PATH_STYLE=true only if the bucket
# requires path-style addressing.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# Railway persistent cleanup worker (PRINT_CESS_CLEANUP_PROVIDER=railway-worker).
# The worker authenticates sweeps with this shared secret (>= 32 chars),
# distinct from ADMIN_DIAGNOSTICS_SECRET. Consumed by both the web
# /api/cleanup route and the apps/cleanup-worker process.
CLEANUP_WORKER_SECRET=

# apps/cleanup-worker process configuration.
CLEANUP_ENDPOINT=
# Optional when Vercel Deployment Protection is enabled for the Preview URL.
# Must match the project's Protection Bypass for Automation secret.
VERCEL_AUTOMATION_BYPASS_SECRET=
CLEANUP_INTERVAL_MS=5000
CLEANUP_BATCH_SIZE=25
CLEANUP_REQUEST_TIMEOUT_MS=10000

# Windows kiosk runtime (local simulator defaults; never commit real values).
# Mock printing is honored only when PRINT_CESS_ENVIRONMENT is exactly
# Development and the server URL is loopback. Production must use Production,
# false, an HTTPS server URL, and the exact approved Blob download host(s).
PRINT_CESS_ENVIRONMENT=Development
PRINT_CESS_SERVER_BASE_URL=http://localhost:3000
PRINT_CESS_KIOSK_REGISTRATION_SECRET=
PRINT_CESS_PRINTER_NAME=
PRINT_CESS_ADMIN_PASSWORD_HASH=
PRINT_CESS_USE_MOCK_PRINT_ENGINE=true
PRINT_CESS_ALLOWED_BLOB_HOSTS=localhost
