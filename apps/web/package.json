{
  "name": "@print-cess/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:integration": "vitest run test/integration",
    "test:provider": "node scripts/provider-preflight.mjs && vitest run --config vitest.provider.config.ts",
    "pretest:e2e": "pnpm --filter @print-cess/test-fixtures build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@opencvjs/web": "5.0.0-release.2",
    "@print-cess/crypto": "workspace:*",
    "@print-cess/i18n": "workspace:*",
    "@print-cess/protocol": "workspace:*",
    "@print-cess/ui": "workspace:*",
    "@upstash/qstash": "2.12.0",
    "@upstash/redis": "1.39.0",
    "@vercel/blob": "2.8.2",
    "heic-to": "1.6.6",
    "i18next": "26.4.6",
    "lucide-react": "1.57.0",
    "next": "16.4.2",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.18",
    "redis": "6.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@print-cess/test-fixtures": "workspace:*",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
