{
  "name": "paradiso-print-cess",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Secure self-service document printing",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "benchmark:scanner:smoke": "node scripts/scanner-benchmark/score.mjs benchmarks/scanner/fixtures/ci-smoke.json artifacts/scanner-benchmark/scanner-quality-report.json",
    "build": "turbo run build",
    "create:readiness-evidence-template": "node scripts/acceptance/create-readiness-evidence-template.mjs",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @print-cess/web test:integration",
    "test:provider": "turbo run build --filter=@print-cess/web^... && pnpm --filter @print-cess/web test:provider",
    "test:acceptance-evidence": "node --test scripts/acceptance/*.test.mjs",
    "test:kiosk-scripts": "node --test scripts/kiosk/*.test.mjs",
    "test:scanner-benchmark": "node --test scripts/scanner-benchmark/*.test.mjs",
    "test:workflow": "node --test scripts/github/*.test.mjs",
    "validate:readiness-evidence": "node scripts/acceptance/validate-readiness-evidence.mjs",
    "test:e2e": "pnpm --filter @print-cess/web test:e2e",
    "fixtures": "pnpm --filter @print-cess/test-fixtures generate"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "7.0.2"
  }
}
